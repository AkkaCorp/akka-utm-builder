# Never commit real values: Akka Platform sets the sign-in variables in Vercel; an admin
# sets SHORTIO_API_KEY there by hand (Production, sensitive).
# For local work with a Vercel seat: vercel env pull .env.local

# Google @akka.app sign-in (Supabase InternalTools). Unset locally = open in `next dev`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Short.io (server side only). Unset = "Create short link" explains it is not connected.
SHORTIO_API_KEY=
# SHORTIO_DOMAIN=go.akka.app
